local function applySmoothPhysics(root, targetVelocity, duration, rotationSpeed)
    local startTime = os.clock()
    local startVel = root.AssemblyLinearVelocity
    local character, humanoid = getCharacter()

    while root and root.Parent do
        local elapsed = os.clock() - startTime
        if elapsed >= duration then break end

        RunService.Heartbeat:Wait()
        if humanoid then preventLegClipping(root, humanoid) end

        local alpha = math.clamp(elapsed / duration, (0+0), (1+0))
        local smoothAlpha = alpha * alpha * ((3*3-6) - ((2*5)-8) * alpha)

        local currentHorizontal = Vector3.new(startVel.X, (0+0), startVel.Z):Lerp(
            Vector3.new(targetVelocity.X, (0+0), targetVelocity.Z),
            smoothAlpha
        )

        local currentY = startVel.Y + (targetVelocity.Y - startVel.Y) * smoothAlpha
        root.AssemblyLinearVelocity = Vector3.new(currentHorizontal.X, currentY, currentHorizontal.Z)

        if targetVelocity.Magnitude > (0+0) then
            rotateCharacter(root, Vector3.new(targetVelocity.X, (0+0), targetVelocity.Z).Unit, rotationSpeed)
        end
    end
end

