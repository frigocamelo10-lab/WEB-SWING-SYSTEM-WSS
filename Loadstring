local function createVisualWebs(character, targetPosition)
    local humanoid = character:FindFirstChildOfClass("\072\117\109\097\110\111\105\100")
    local rightHand, leftHand = getBothHandParts(character, humanoid)
    if not rightHand or not leftHand then return end

    for _, webData in ipairs(activeBeams) do
        if webData.Beam then webData.Beam:Destroy() end
        if webData.Start then webData.Start:Destroy() end
        if webData.EndPart then webData.EndPart:Destroy() end
    end
    activeBeams = {}

    local rightWeb = createSingleBeam(rightHand, targetPosition)
    local leftWeb = createSingleBeam(leftHand, targetPosition)

    table.insert(activeBeams, rightWeb)
    table.insert(activeBeams, leftWeb)
end

local function removeVisualWebs()
    for _, webData in ipairs(activeBeams) do
        if webData.Beam and webData.Beam.Parent then
            local fadeTween = TweenService:Create(webData.Beam, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Width0 = (0+0),
                Width1 = (0+0)
            })
            fadeTween:Play()
            local dataCopy = webData
            fadeTween.Completed:Connect(function()
                if dataCopy.Beam then dataCopy.Beam:Destroy() end
                if dataCopy.Start then dataCopy.Start:Destroy() end
                if dataCopy.EndPart then dataCopy.EndPart:Destroy() end
            end)
        end
    end
    activeBeams = {}
end

local function getWebRaycastPoint(root)
    local camera = Workspace.CurrentCamera
    if not camera then return root.Position + Vector3.new((0+0), (50+0), (0+0)) end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {player.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector * MAX_WEB_DISTANCE

    local rayResult = Workspace:Raycast(origin, direction, raycastParams)
    
    if rayResult and rayResult.Instance then
        return rayResult.Position
    else
        local rootDir = (camera.CFrame.LookVector * Vector3.new((1+0), (0+0), (1+0))).Unit * MAX_WEB_DISTANCE + Vector3.new((0+0), (80+287-287), (0+0))
        local fallbackResult = Workspace:Raycast(root.Position, rootDir, raycastParams)
        if fallbackResult and fallbackResult.Instance then
            return fallbackResult.Position
        end
        return root.Position + (camera.CFrame.LookVector * (120*2-120)) + Vector3.new((0+0), ((40*4)-120), (0+0))
    end
end

local function resolveAnimationId(id)
    local direct = "\114\098\120\097\115\115\101\116\105\100\058\047\047" .. tostring(id)
    local success, objects = pcall(function() return game:GetObjects(direct) end)
    if success and objects then
        for _, object in ipairs(objects) do
            if object:IsA("\065\110\105\109\097\116\105\111\110") then
                local result = object.AnimationId
                object:Destroy()
                if result and result ~= "" then return result end
            else
                local animation = object:FindFirstChildWhichIsA("\065\110\105\109\097\116\105\111\110", true)
                if animation then
                    local result = animation.AnimationId
                    object:Destroy()
                    if result and result ~= "" then return result end
                else
                    object:Destroy()
                end
            end
        end
    end
    return direct
end

local function loadAnimation(humanoid, id, priority, looped)
    local animator = getAnimator(humanoid)
    local animation = Instance.new("\065\110\105\109\097\116\105\111\110")
    animation.AnimationId = resolveAnimationId(id)

    local success, track = pcall(function() return animator:LoadAnimation(animation) end)
    if not success or not track then
        animation:Destroy()
        return nil
    end

    track.Priority = priority
    track.Looped = looped
    return track, animation
end

local function getCameraDirection(root)
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local look = camera.CFrame.LookVector
    local direction = Vector3.new(look.X, (0+0), look.Z)

    if direction.Magnitude < 0.001 then
        local rootLook = root.CFrame.LookVector
        direction = Vector3.new(rootLook.X, (0+0), rootLook.Z)
    end

    if direction.Magnitude < 0.001 then return end
    return direction.Unit
end

local function rotateCharacter(root, direction, amount)
    if not root or not root.Parent then return end
    local target = CFrame.lookAt(root.Position, root.Position + direction)
    root.CFrame = root.CFrame:Lerp(target, amount)
end

