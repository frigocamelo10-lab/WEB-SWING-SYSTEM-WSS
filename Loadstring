local function pwebPhysics(root, direction, forwardSpeed, upSpeed)
    if not root or not root.Parent then return end
    
    local currentHorizontal = Vector3.new(root.AssemblyLinearVelocity.X, (0+0), root.AssemblyLinearVelocity.Z).Magnitude
    local finalForward = math.max(currentHorizontal + forwardSpeed * 0.5, forwardSpeed)

    local targetVel = direction * finalForward + Vector3.new((0+0), upSpeed, (0+0))

    applySmoothPhysics(root, targetVel, PWEB_ACCEL_TIME, 0.12)

    if not root.Parent then return end

    root.AssemblyLinearVelocity = Vector3.new(targetVel.X, upSpeed, targetVel.Z)
    local sustainStart = os.clock()

    while root.Parent do
        if os.clock() - sustainStart >= 0.45 then break end

        local current = root.AssemblyLinearVelocity
        local corrected = Vector3.new(current.X, (0+0), current.Z):Lerp(direction * finalForward, 0.06)
        local vertical = current.Y + (upSpeed - current.Y) * 0.04

        root.AssemblyLinearVelocity = Vector3.new(corrected.X, vertical, corrected.Z)
        rotateCharacter(root, direction, 0.04)
        RunService.Heartbeat:Wait()
    end
end

