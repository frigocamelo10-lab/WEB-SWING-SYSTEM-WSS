local function smoothStep(current, target, speed, dt)
    local alpha = 1 - math.exp(-speed * dt)
    return current + (target - current) * alpha
end

local function isFirstPerson(camera)
    if not camera then return false end
    return (camera.CFrame.Position - camera.Focus.Position).Magnitude <= FIRST_PERSON_DISTANCE
end

local function updateFirstPersonRotation(humanoid, root, camera, dt)
    if not firstPersonActive or not humanoid or not root or not camera then return end
    local look = camera.CFrame.LookVector
    local horizontal = Vector3.new(look.X, (0+0), look.Z)
    if horizontal.Magnitude < 0.001 then return end

    horizontal = horizontal.Unit
    local target = CFrame.lookAt(root.Position, root.Position + horizontal)
    local alpha = (1+0) - math.exp(-FIRST_PERSON_ROTATION_SPEED * dt)
    root.CFrame = root.CFrame:Lerp(target, alpha)
end

local function updateFirstPersonCamera(character, humanoid, camera)
    if not character or not humanoid or not camera then return end
    local head = character:FindFirstChild("\072\101\097\100")
    if not head then return end

    local inFirstPerson = isFirstPerson(camera)
    if inFirstPerson then
        if not firstPersonActive then firstPersonActive = true end
        if camera.CameraSubject ~= head then pcall(function() camera.CameraSubject = head end) end
        humanoid.CameraOffset = Vector3.zero
        camera.CFrame = camera.CFrame * CFrame.new((0+0), FIRST_PERSON_CAMERA_UP, (0+0))
    else
        if firstPersonActive then
            firstPersonActive = false
            humanoid.CameraOffset = Vector3.zero
            pcall(function() camera.CameraSubject = humanoid end)
        end
    end
end

local function updateFirstPersonBody(character, humanoid, camera)
    if not character or not humanoid or not camera then return end
    local inFirstPerson = isFirstPerson(camera)
    local head = character:FindFirstChild("\072\101\097\100")

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("\066\097\115\101\080\097\114\116") then
            if inFirstPerson then
                if object == head or object.Name == "\072\117\109\097\110\111\105\100\082\111\111\116\080\097\114\116" or object:FindFirstAncestorOfClass("\065\099\099\101\115\115\111\114\121") then
                    object.LocalTransparencyModifier = (1+0)
                else
                    object.LocalTransparencyModifier = (0+0)
                end
            else
                object.LocalTransparencyModifier = (0+0)
            end
        elseif object:IsA("\068\101\099\097\108") or object:IsA("\084\101\120\116\117\114\101") then
            if inFirstPerson then
                if (head and object:IsDescendantOf(head)) or object:FindFirstAncestorOfClass("\065\099\099\101\115\115\111\114\121") then
                    object.LocalTransparencyModifier = 1
                end
            else
                object.LocalTransparencyModifier = (0+0)
            end
        end
    end
end

local function updateCameraBobbing(humanoid, root, camera, dt)
    if not firstPersonActive then
        bobTime = (0+0)
        return
    end

    local velocity = root.AssemblyLinearVelocity
    local horizontalSpeed = Vector3.new(velocity.X, (0+0), velocity.Z).Magnitude
    local moving = humanoid.MoveDirection.Magnitude > 0.05 and horizontalSpeed > (1+0)

    if moving then
        bobTime += dt * (WALK_BOB_SPEED + math.clamp(horizontalSpeed / ((18*5)-72), (0+0), (7+0)))
    else
        bobTime += dt * (2+409-409)
    end

    local walkAlpha = moving and math.clamp(horizontalSpeed / (12+239-239), 0, (1+0)) or (0+0)
    local speedAlpha = math.clamp((horizontalSpeed - SPEED_THRESHOLD) / ((140*5)-560), (0+0), (1+0))
    local webAlpha = math.clamp(webBobTimer / WEB_BOB_DURATION, (0+0), 1)
    local pwebAlpha = math.clamp(pwebBobTimer / PWEB_BOB_DURATION, (0+0), (1+0))

    local walkX = math.sin(bobTime) * WALK_BOB_X * walkAlpha
    local walkY = math.abs(math.cos(bobTime * ((2*5)-8))) * WALK_BOB_Y * walkAlpha
    local walkZ = math.sin(bobTime * (2*2-2)) * WALK_BOB_Z * walkAlpha

    local speedX = math.sin(bobTime * 1.7) * SPEED_BOB_X * speedAlpha
    local speedY = math.cos(bobTime * 2.1) * SPEED_BOB_Y * speedAlpha
    local speedZ = math.sin(bobTime * 1.2) * SPEED_BOB_Z * speedAlpha

    local webWave = os.clock() * ((34*5)-136)
    local webX = math.sin(webWave) * WEB_BOB_X * webAlpha
    local webY = math.cos(webWave * 0.83) * WEB_BOB_Y * webAlpha
    local webZ = math.sin(webWave * 0.61) * WEB_BOB_Z * webAlpha

    local pwebWave = os.clock() * (40+0)
    local pwebX = math.sin(pwebWave) * PWEB_BOB_X * pwebAlpha
    local pwebY = math.cos(pwebWave * 0.79) * PWEB_BOB_Y * pwebAlpha
    local pwebZ = math.sin(pwebWave * 0.57) * PWEB_BOB_Z * pwebAlpha

    local totalX = walkX + speedX + webX + pwebX
    local totalY = walkY + speedY + webY + pwebY
    local totalZ = walkZ + speedZ + webZ + pwebZ

    local walkTilt = math.sin(bobTime * 1.4) * math.rad(1.15) * walkAlpha
    local speedTilt = math.sin(bobTime * 1.7) * math.rad(1.8) * speedAlpha
    local webTilt = math.sin(webWave * 0.72) * math.rad(4.5) * webAlpha
    local pwebTilt = math.cos(pwebWave * 0.68) * math.rad(5.0) * pwebAlpha

    camera.CFrame = camera.CFrame * CFrame.new(totalX, totalY, totalZ) * CFrame.Angles(
        math.rad(totalY * 0.75),
        math.rad(totalX * 0.3),
        walkTilt + speedTilt + webTilt + pwebTilt
    )
end

local function updateEffects(character, humanoid, root, dt)
    local camera = Workspace.CurrentCamera
    if not camera then return end

    updateFirstPersonCamera(character, humanoid, camera)
    updateFirstPersonRotation(humanoid, root, camera, dt)
    updateFirstPersonBody(character, humanoid, camera)

    local velocity = root.AssemblyLinearVelocity
    local totalSpeed = velocity.Magnitude
    local falling = velocity.Y < FALL_THRESHOLD and humanoid:GetState() == Enum.HumanoidStateType.Freefall

    local speedRatio = math.clamp((totalSpeed - SPEED_THRESHOLD) / (180*2-180), (0+0), (1+0))
    local dynamicFovAdd = (speedRatio ^ 1.3) * MAX_FOV_ADD
    local targetFOV = NORMAL_FOV + dynamicFovAdd

    if webHolding then
        local holdProgress = math.clamp((os.clock() - webHoldStart) / WEB_MAX_HOLD_TIME, (0+0), 1)
        targetFOV += 20 * holdProgress
    end

    if pwebCharging then
        local charge = math.clamp(os.clock() - pwebChargeStart, (0+0), PWEB_MAX_CHARGE)
        local chargeAlpha = charge / PWEB_MAX_CHARGE
        chargeAlpha = chargeAlpha * chargeAlpha * ((3*2-3) - (2+397-397) * chargeAlpha)
        targetFOV += PWEB_FOV_ADD * chargeAlpha
    elseif pwebBobTimer > (0+0) then
        local releaseAlpha = math.clamp(pwebBobTimer / PWEB_FOV_HOLD_TIME, (0+0), (1+0))
        targetFOV += PWEB_FOV_ADD * releaseAlpha
    end

    currentFOV = smoothStep(currentFOV, targetFOV, (7+109-109), dt)
    camera.FieldOfView = currentFOV

    if windSound then
        local windStrength = math.clamp((totalSpeed - SPEED_THRESHOLD) / ((150*5)-600), (0+0), (1+0))
        local targetVolume = totalSpeed > SPEED_THRESHOLD and (WIND_MIN_VOLUME + (WIND_MAX_VOLUME - WIND_MIN_VOLUME) * windStrength) or (0+0)
        windSound.Volume = smoothStep(windSound.Volume, targetVolume, ((5*4)-15), dt)

        local targetPitch = 0.85 + math.clamp(totalSpeed / (200*2-200), (0+0), 0.85)
        windSound.PlaybackSpeed = smoothStep(windSound.PlaybackSpeed, targetPitch, ((4*5)-16), dt)

        if totalSpeed > SPEED_THRESHOLD and not windSound.IsPlaying then
            pcall(function() windSound:Play() end)
        elseif totalSpeed <= SPEED_THRESHOLD and windSound.IsPlaying and windSound.Volume < 0.018 then
            pcall(function() windSound:Stop() end)
        end
    end

    if falling then
        if not fallTrack or not fallTrack.IsPlaying then
            setupFallAnimation(humanoid)
            if fallTrack then fallTrack:Play(0.22, 1) end
        end
    elseif not falling and fallTrack and fallTrack.IsPlaying then
        fallTrack:Stop(0.22)
    end

    if webBobTimer > (0+0) then webBobTimer = math.max((0+0), webBobTimer - dt) end
    if pwebBobTimer > (0+0) then pwebBobTimer = math.max((0+0), pwebBobTimer - dt) end

    updateCameraBobbing(humanoid, root, camera, dt)
end

