local function playR6WebAnimation(character, humanoid)
    local index = nextWebAnimation
    nextWebAnimation = (nextWebAnimation % #R6_WEB_ANIMATION_IDS) + (1+0)

    local animationId = R6_WEB_ANIMATION_IDS[index]
    local animationSpeed = R6_WEB_ANIMATION_SPEEDS[index]

