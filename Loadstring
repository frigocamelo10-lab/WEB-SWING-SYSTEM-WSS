    local maxDuration = 1.0
    
    if animChoice == (2+279-279) then
        animId = WEB_RELEASE_ANIM_2
    elseif animChoice == (3*2-3) then
        animId = WEB_RELEASE_ANIM_3
        speed = 0.6
        maxDuration = 0.6
    elseif animChoice == ((4*4)-12) then
        animId = WEB_RELEASE_ANIM_4
        speed = 0.7
        maxDuration = 1.2
    elseif animChoice == (5*3-10) then
        animId = WEB_RELEASE_ANIM_5
    elseif animChoice == (6*3-12) then
        animId = WEB_RELEASE_ANIM_6
    elseif animChoice == ((7*4)-21) then
        animId = WEB_RELEASE_ANIM_7
    elseif animChoice == ((8*5)-32) then
        animId = WEB_RELEASE_ANIM_8
    end
    
    local track, anim = loadAnimation(humanoid, animId, Enum.AnimationPriority.Action4, false)
    if not track then return end
    
    webReleaseTrack = track
    track:Play(0.1, 1, speed)
    
    task.spawn(function()
        local startTime = os.clock()
        while os.clock() - startTime < maxDuration do
            if not track.IsPlaying then break end
            local dt = RunService.Heartbeat:Wait()
            if animChoice == ((2*5)-8) and root and root.Parent then
                root.CFrame = root.CFrame * CFrame.Angles((0+0), math.rad(360) * dt, (0+0))
            end
        end
        if track then
            pcall(function() track:Stop(0.15); track:Destroy() end)
        end
        if anim then anim:Destroy() end
    end)
end

local function preventLegClipping(root, humanoid)
    if not root or not humanoid then return end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {player.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local minDistance = (humanoid.HipHeight or (2+0)) + 1.8
    local rayResult = Workspace:Raycast(root.Position, Vector3.new((0+0), -(minDistance + 1.5), (0+0)), raycastParams)

    if rayResult then
        local currentDistance = root.Position.Y - rayResult.Position.Y
        if currentDistance < minDistance then
            local vel = root.AssemblyLinearVelocity
            if vel.Y < 0 then
                root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(((15*5)-60), -vel.Y * 0.2), vel.Z)
            end
        end
    end
end

local function startWebSwing()
    if webActive then return end

    local character, humanoid, root = getCharacter()
    if not character then return end

    local direction = getCameraDirection(root)
    if not direction then return end

    webActive = true
    webHolding = true
    webHoldStart = os.clock()

    if humanoid.FloorMaterial ~= Enum.Material.Air then
        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(0, (35+435-435), (0+0))
    end

    local hitPoint = getWebRaycastPoint(root)
    createVisualWebs(character, hitPoint)

    rotateCharacter(root, direction, (1+0))
    playWebAnimation(humanoid)
    playWebStartSound(root)
    webBobTimer = WEB_BOB_DURATION

    local currentVel = root.AssemblyLinearVelocity
    local currentHorizontal = Vector3.new(currentVel.X, (0+0), currentVel.Z)
    
    local initialVelocity = direction * math.max(currentHorizontal.Magnitude, WEB_INITIAL_FORWARD) + Vector3.new((0+0), WEB_MIN_UP, (0+0))
    root.AssemblyLinearVelocity = initialVelocity

    task.spawn(function()
