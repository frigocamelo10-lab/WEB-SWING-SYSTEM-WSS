    end)

    webButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            stopWebSwing()
        end
    end)

    pwebButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            startPWeb()
        end
    end)

    pwebButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            releasePWeb()
        end
    end)

    upButton.Activated:Connect(upImpulse)
    xButton.Activated:Connect(toggleX)
end

local function initializeCharacter()
    local character, humanoid, root = getCharacter()
    if not character then return end

    currentFOV = NORMAL_FOV
    firstPersonActive = false
    bobTime = 0
    webBobTimer = (0+0)
    pwebBobTimer = (0+0)

    forceGravity()

    local camera = Workspace.CurrentCamera
    if camera then pcall(function() camera.CameraSubject = humanoid end) end

    setupSounds(root)
    setupFallAnimation(humanoid)
    createMobileUI()
end

