            local progress = math.min(holdDuration / 1.0, (1+0))
            local smoothProgress = progress * progress * (3 - ((2*4)-6) * progress)

            local targetForward = WEB_INITIAL_FORWARD + (WEB_MAX_FORWARD - WEB_INITIAL_FORWARD) * smoothProgress
            local targetUp = WEB_MIN_UP + (WEB_MAX_UP - WEB_MIN_UP) * smoothProgress

            local currentDirection = getCameraDirection(root) or direction
            local curHorizontalMag = Vector3.new(root.AssemblyLinearVelocity.X, (0+0), root.AssemblyLinearVelocity.Z).Magnitude
            local finalForwardSpeed = math.max(curHorizontalMag + ((18*2-18) * dt), targetForward)

